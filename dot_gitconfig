[core]
    excludesfile = ~/.gitignore
    autocrlf = input
[user]
    name = Tamika Nomara
    email = taminomara@gmail.com
[commit]
    gpgsign = false
[tag]
    gpgsign = false
[alias]
    graph = gr
    gr = "!cd -- \"${GIT_PREFIX:-.}\" && git -c pager.log=\"sed -E 's/\\x1b\\[33m(G)\\x1b\\[m/\\x1b[7;32m\\1\\x1b[m/; s/\\x1b\\[33m(N)\\x1b\\[m/\\x1b[2;37m\\1\\x1b[m/; s/\\x1b\\[33m([BRXY])\\x1b\\[m/\\x1b[7;31m\\1\\x1b[m/; s/\\x1b\\[33m([EU])\\x1b\\[m/\\x1b[7;33m\\1\\x1b[m/' | less\" log --graph --format=format:'%C(blue)%h%C(reset) %C(yellow)%G?%C(reset) %C(green)(%ar)%C(reset) %C(bold white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' \"$@\""
    st = status
    co = checkout
    ci = commit
    cim = commit -m
    cia = commit --amend --no-edit
    br = branch
    sw = switch
    aa = add -A
    p = push
    pf = push --force-with-lease
    sp = stash push
    spp = stash pop
    l = gr HEAD origin/HEAD
    wip = stash push -u
    unwip = "!f() { \
        h=$(git rev-parse HEAD) || return 1; \
        s=$(git stash list --format='%gd %P' | awk -v h=$h '$2 == h { print $1; exit }'); \
        if [ -z \"$s\" ]; then echo \"unwip: nothing stashed at this commit ($h)\" >&2; return 2; fi; \
        echo \"unwip: popping $s\"; \
        git stash pop \"$s\"; \
    }; f"
    swap = "!f() { \
        before=$(git rev-parse -q --verify refs/stash); \
        git wip || return 1; \
        after=$(git rev-parse -q --verify refs/stash); \
        if git switch \"$@\"; then \
            git unwip; rc=$?; \
                if [ $rc -eq 2 ]; then return 0; fi; \
                return $rc; \
        else \
            rc=$?; \
            if [ \"$before\" != \"$after\" ]; then echo 'swap: switch failed, restoring stash' >&2; git stash pop; fi; \
                return $rc; \
        fi; \
    }; f"
    sync-fork = "!f() { \
        up=$(git config syncfork.upstream || echo upstream); \
        fork=$(git config syncfork.fork || echo origin); \
        git fetch \"$up\" || return 1; \
        br=$1; \
        if [ -z \"$br\" ]; then \
            git symbolic-ref -q \"refs/remotes/$up/HEAD\" >/dev/null || git remote set-head \"$up\" --auto >/dev/null || return 1; \
            br=$(git symbolic-ref --short \"refs/remotes/$up/HEAD\") || return 1; \
            br=${br#*/}; \
        fi; \
        target=\"refs/remotes/$up/$br\"; \
        git rev-parse -q --verify \"$target\" >/dev/null || { echo \"sync-fork: no such ref $up/$br\" >&2; return 1; }; \
        wt=$(git worktree list --porcelain | awk -v b=\"branch refs/heads/$br\" '/^worktree /{w=substr($0,10)} $0==b{print w; exit}'); \
        if [ -n \"$wt\" ]; then \
            if [ -n \"$(git -C \"$wt\" status --porcelain --untracked-files=no)\" ]; then \
                echo \"sync-fork: $br is checked out at $wt with uncommitted changes\" >&2; return 1; \
            fi; \
            git -C \"$wt\" reset --hard \"$target\" || return 1; \
        else \
            git update-ref -m \"sync-fork: reset to $up/$br\" \"refs/heads/$br\" \"$target\" || return 1; \
        fi; \
        echo \"sync-fork: $br is now at $(git rev-parse --short \"$br\") ($up/$br)\"; \
        git push --force-with-lease \"$fork\" \"$up:$br\"; \
    }; f"
[push]
    autoSetupRemote = true
[pull]
    ff = only
    rebase = true
[init]
    defaultBranch = main
[diff]
    algorithm = histogram
    indentHeuristic = true
    renames = copies
    colorMoved = plain
    mnemonicPrefix = true
[rebase]
    autosquash = true
    autoStash = true
[fetch]
    all = true
    prune = true
    pruneTags = false
[rerere]
    enabled = true
    autoUpdate = true

[merge]
    tool = vimdiff
    conflictstyle = diff3
[mergetool]
    prompt = false
[blame]
    ignoreRevsFile =
